<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>OurHappyHome</RootNamespace>
    <AssemblyName>OurHappyHome</AssemblyName>
    <IsPackable>false</IsPackable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.2" />
    <PackageReference Include="ThreeNet" Version="0.7.0" />
    <PackageReference Include="ThreeNet.Avalonia" Version="0.7.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OurHappyHome.Core\OurHappyHome.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 3D models (Rodin + Blender rigging), concept art, voice lines. -->
    <None Include="Assets\Models\**\*.glb" CopyToOutputDirectory="PreserveNewest" LinkBase="Assets\Models" />
    <None Include="Assets\Voice\**\*.mp3" CopyToOutputDirectory="PreserveNewest" LinkBase="Assets\Voice" />
    <AvaloniaResource Include="Assets\Art\**\*" />
    <AvaloniaResource Include="Assets\icon.ico" />
  </ItemGroup>

</Project>
